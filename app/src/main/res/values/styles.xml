<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Main app theme using Material Components -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/colorAccent</item>
    </style>

    <!-- Simple spinner text color theme -->
    <style name="spinnerTheme">
        <item name="android:textColor">@color/Mmy_spinner_text_color</item>
    </style>

    <!-- Header bar background color -->
    <style name="HeaderBar">
        <item name="android:background">#303F9F</item>
    </style>

    <!-- Toolbar style: apply this with style="@style/CustomToolbarStyle" on your toolbar -->
    <style name="CustomToolbarStyle" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/button_background</item>
        <item name="titleTextColor">@color/white</item>
        <item name="subtitleTextColor">@color/white</item>
    </style>

    <!-- Spinner item text colors (no AppCompat dependency) -->
    <style name="mySpinnerItemStyle" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/my_spinner_text_color</item>
    </style>

    <style name="MmySpinnerItemStyle" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/Mmy_spinner_text_color</item>
    </style>

    <!-- NoActionBar variant of AppTheme -->
    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <!-- These attributes are recognized even if Studio shows them in red -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- AppBar/Text button styles -->
    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar" />

    <style name="MyColoredButtonStyle" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.MaterialComponents.Light" />

    <!-- Spinner dropdown item style -->
    <style name="spinnerItemStyle" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/colorText</item>
    </style>

    <!-- Fullscreen theme variant -->
    <style name="FullscreenTheme" parent="AppTheme.NoActionBar">
        <item name="android:windowActionBarOverlay">true</item>
        <item name="android:windowBackground">@null</item>
        <item name="metaButtonBarStyle">?android:attr/buttonBarStyle</item>
        <item name="metaButtonBarButtonStyle">?android:attr/buttonBarButtonStyle</item>
    </style>

    <style name="FullscreenActionBarStyle" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/black_overlay</item>
    </style>

</resources>
