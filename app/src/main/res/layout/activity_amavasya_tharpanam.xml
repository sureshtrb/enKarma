<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
                xmlns:tools="http://schemas.android.com/tools" android:id="@+id/llScroll"
                android:layout_width="fill_parent" android:layout_height="fill_parent"
                android:orientation="vertical">
    <Button android:id="@+id/printButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/print"
            android:textSize="16sp"
            android:textStyle="bold|italic" android:ellipsize="none" android:focusableInTouchMode="true"
            android:background="@drawable/buttonstyle" android:textColor="@color/cardview_light_background"
            style="@style/Widget.AppCompat.Button.Small" android:minHeight="24dp"
            tools:ignore="NewApi,PrivateResource,RelativeOverlap" android:fontFamily="sans-serif-medium"/>

    <ScrollView

            android:id="@+id/root_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:scaleType = "centerCrop"
            android:background = "@drawable/yagyavalkyar">

        <LinearLayout
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:context=".AmavasyaTpnmActivity">

            <TextView
                    android:typeface="monospace"
                    android:textStyle="normal"
                    android:textSize="15sp"

                    android:textAlignment="center"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:id="@+id/AmavasyaTPNMTextView"

                    app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintEnd_toEndOf="parent"
                android:gravity="center_horizontal" />

              <!-- Media Controls -->
    <LinearLayout
        android:id="@+id/mediaControlsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/AmavasyaTPNMTextView"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnPlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Play" />

            <Button
                android:id="@+id/buttonPausePlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pause" />

            <Button
                android:id="@+id/btnStop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stop" />

        </LinearLayout>

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPass"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="00:00" />

            <TextView
                android:id="@+id/tvDue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="00:00" />

        </LinearLayout>

    </LinearLayout>

        </LinearLayout>
    </ScrollView>
</RelativeLayout>
