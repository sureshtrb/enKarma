<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screen"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical">
    <Button android:id="@+id/printButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/print"
            android:textSize="16sp"
            android:textStyle="bold|italic" android:ellipsize="none" android:focusableInTouchMode="true"
            android:background="@drawable/buttonstyle" android:textColor="@color/cardview_light_background"
            style="@style/Widget.AppCompat.Button.Small" android:minHeight="24dp"
            tools:ignore="NewApi,PrivateResource,RelativeOverlap" />
    <ScrollView
            android:id="@+id/root_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:scaleType="centerCrop"
            android:background="@drawable/yagyavalkyar" android:layout_marginTop="0dp"
            android:layout_below="@+id/printButton">

        <LinearLayout
            android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:context=".GayathriJapamActivity"
            android:orientation="horizontal">

            <TextView
                    android:typeface="monospace"
                    android:textStyle="normal"
                    android:textSize="15sp"

                    android:textAlignment="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/gayathrijapamTextView"

                    app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintEnd_toEndOf="parent"
                android:gravity="center_horizontal" />

        </LinearLayout>

    </ScrollView>
</RelativeLayout>