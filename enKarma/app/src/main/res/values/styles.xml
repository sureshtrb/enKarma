<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/colorAccent</item>
    </style>

    <style name="spinnerTheme" parent="Widget.AppCompat.Spinner">
        <item name="android:textColor">@color/my_spinner_text_color</item>
    </style>

    <style name="HeaderBar">
        <item name="android:background">#303F9F</item>
    </style>

    <style name="CustomTheme" parent="Theme.MaterialComponents.Light">
        <item name="navigationIcon">@drawable/home</item>
        <item name="contentInsetStart">0dp</item>
        <item name="contentInsetEnd">0dp</item>
    </style>

    <style name="mySpinnerItemStyle" parent="Widget.AppCompat.Spinner"> <!-- ✅ Fix capitalization -->
        <item name="android:textColor">@color/my_spinner_text_color</item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="MyColoredButtonStyle" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="spinnerItemStyle" parent="Widget.AppCompat.Spinner">
        <item name="android:textColor">@color/colorText</item>
        <item name="android:background">@color/colorText</item>
    </style>

    <style name="FullscreenTheme" parent="AppTheme">
        <item name="android:actionBarStyle">@style/FullscreenActionBarStyle</item>
        <item name="android:windowActionBarOverlay">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="metaButtonBarStyle">?android:attr/buttonBarStyle</item>
        <item name="metaButtonBarButtonStyle">?android:attr/buttonBarButtonStyle</item>
    </style>

    <style name="FullscreenActionBarStyle" parent="Widget.AppCompat.ActionBar">
        <item name="android:background">@color/black_overlay</item>
    </style>

    <style name="Theme" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Leave empty or add theme customizations here -->
    </style>

    <style name="MySpinnerItemStyle" parent="Widget.AppCompat.Spinner">
        <item name="android:textColor">@color/my_spinner_text_color</item>
    </style>

</resources>
